          "raw": "{\n  \"nome\": \"Higiene\"\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/grupos-produtos"
      }
    },
    {
      "name": "10 - Listar grupos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/grupos-produtos"
      }
