{
  "info": {
    "_postman_id": "a7c3e9d1-4b2f-4e18-9c5a-petshop-aula07",
    "name": "Petshop 2026 - Aula 07",
    "description": "Coleção da Aula 07 do curso Spring Boot 2026, adaptada ao tema petshop.\n\nExecute na ordem: health, grupo, fornecedor, produto, consultas e erros.\nA aplicação deve estar em http://localhost:8080 com o profile dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "grupoId",
      "value": ""
    },
    {
      "key": "fornecedorId",
      "value": ""
    },
    {
      "key": "produtoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "01 - Cadastrar grupo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Grupo deve ser criado\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Resposta deve possuir id\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"grupoId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ração\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/grupos-produtos"
      }
    },
    {
      "name": "02 - Cadastrar fornecedor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Fornecedor deve ser criado\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"fornecedorId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razaoSocial\": \"Pet Distribuidora Ltda\",\n  \"cnpj\": \"12345678000199\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/fornecedores"
      }
    },
    {
      "name": "03 - Cadastrar produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Produto deve ser criado\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Produto deve referenciar grupo e fornecedor\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.grupoId).to.eql(",
              "        Number(pm.collectionVariables.get(\"grupoId\"))",
              "    );",
              "    pm.expect(body.fornecedorId).to.eql(",
              "        Number(pm.collectionVariables.get(\"fornecedorId\"))",
              "    );",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"produtoId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"AULA07-RACAO-001\",\n  \"descricao\": \"Ração Golden Adulto 15kg\",\n  \"saldoEstoque\": 20.000,\n  \"valorUnitario\": 189.90,\n  \"estoqueMinimo\": 5,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/produtos"
      }
    },
    {
      "name": "04 - Buscar produto por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Consulta deve retornar 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Deve retornar o produto solicitado\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.eql(",
              "        Number(pm.collectionVariables.get(\"produtoId\"))",
              "    );",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/{{produtoId}}"
      }
    },
    {
      "name": "05 - Listar produtos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Listagem deve retornar 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Resposta deve ser uma lista\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos"
      }
    },
    {
      "name": "06 - Produto inválido (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Entrada inválida deve retornar 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Resposta deve identificar campos inválidos\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.fields).to.be.an(\"object\");",
              "    pm.expect(body.fields).to.have.property(\"descricao\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"\",\n  \"descricao\": \"\",\n  \"saldoEstoque\": -2,\n  \"valorUnitario\": -1,\n  \"estoqueMinimo\": -3,\n  \"grupoId\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/produtos"
      }
    },
    {
      "name": "07 - Produto inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Consulta inexistente deve retornar 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Resposta deve seguir ApiError\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql(\"Produto não encontrado\");",
              "    pm.expect(body.path).to.include(\"/api/produtos/\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/produtos/999999999"
      }
    },
    {
      "name": "08 - Código de barras repetido (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código duplicado deve retornar 409\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "pm.test(\"Mensagem deve indicar duplicidade\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.message).to.eql(\"Código de barras já cadastrado\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigoBarras\": \"AULA07-RACAO-001\",\n  \"descricao\": \"Ração Golden Adulto 15kg\",\n  \"saldoEstoque\": 20.000,\n  \"valorUnitario\": 189.90,\n  \"estoqueMinimo\": 5,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/produtos"
      }
    },
